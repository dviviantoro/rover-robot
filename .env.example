# Copy to .env (gitignored) and fill in. Never commit .env — AGENTS.md constraint 8.

# NiceGUI dashboard session auth (M8). The dashboard exposes drive controls on the LAN.
ROBOT_UI_USER=admin
ROBOT_UI_PASSWORD=

# NiceGUI session-cookie signing secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROBOT_UI_STORAGE_SECRET=

# Second lock on robot-core's WebSocket (port 8090), read by robot-core, robot-ui and robot-face.
# Without it the port accepts any client that can reach it (loopback only by default).
# Generate with the same command as above.
CORE_WS_TOKEN=
