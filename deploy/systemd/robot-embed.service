[Unit]
Description=robot-embed -- llama.cpp embedding server (Qwen3-Embedding-0.6B)
Documentation=file:///media/jetson/DATA/robot-py/planning/TECH_STACK.md
After=network.target
PartOf=robot.target

# See memory-budget.md: this is a 0.6B encoder listed as its own line in the same
# steady-state budget as the LLM, not a second generative model. AGENTS.md constraint 2
# is about not holding two of those.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=jetson
Group=jetson
WorkingDirectory=/media/jetson/DATA/robot-py
EnvironmentFile=/media/jetson/DATA/robot-py/config/embed.env
# Keep this process off the GPU entirely -- see the note in embed.env.
Environment=CUDA_VISIBLE_DEVICES=

# Drop this model's page cache before loading it. CUDA on Tegra allocates
# through NvMap and will NOT force the kernel to reclaim cache, so a service
# restarting after a crash finds its own model still cached and fails with
# `cudaMalloc failed: out of memory`. Measured in M9: without this, a killed
# llama-server retried 5 times, hit StartLimitBurst, and stayed down.
ExecStartPre=/media/jetson/DATA/robot-py/.venv/bin/python /media/jetson/DATA/robot-py/scripts/measure/drop_model_cache.py ${EMBED_MODEL}

ExecStart=/media/jetson/DATA/robot-py/vendor/llama.cpp/build/bin/llama-server \
    --model ${EMBED_MODEL} \
    --embeddings \
    --pooling ${EMBED_POOLING} \
    --ctx-size ${EMBED_CTX} \
    --batch-size ${EMBED_BATCH} \
    --ubatch-size ${EMBED_BATCH} \
    --parallel ${EMBED_PARALLEL} \
    --n-gpu-layers ${EMBED_NGL} \
    --host ${EMBED_HOST} \
    --port ${EMBED_PORT} \
    --no-webui

Restart=on-failure
RestartSec=5

# Ingestion is a background job. If memory gets tight this should die before the
# conversation does -- a robot that cannot learn still works; one that cannot talk does not.
OOMScoreAdjust=400

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/media/jetson/DATA/robot-py
PrivateTmp=true

[Install]
WantedBy=robot.target
