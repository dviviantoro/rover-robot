# robot-tts.service tunables. No secrets (AGENTS.md constraint 8) -- this file is tracked.

# Which speaker synthesises.
#
#   piper       one checkpoint per language (M2: RTF 0.24-0.34, ~85 MiB per voice).
#               The default. Its cost is that the three languages are three different
#               checkpoints and therefore three different people -- the robot's voice
#               changes when the conversation does.
#   supertonic  Supertonic-3: ONE ONNX model covering 31 languages including all three
#               of ours, with preset speaker embeddings, so the robot keeps one voice
#               whichever language it answers in. Measured here: 465 MiB resident,
#               1.5 s to load, RTF 0.73-0.82 -- about three times slower than Piper,
#               and synthesis is on the path to first audio.
#
# Needs scripts/models/fetch_supertonic.sh. Pure ONNX Runtime; no PyTorch.
TTS_ENGINE=supertonic
SUPERTONIC_DIR=/media/jetson/DATA/robot-py/models/tts/supertonic
# F1-F5 female, M1-M5 male. The same embedding is used for every language.
SUPERTONIC_VOICE=M1
TTS_THREADS=4

# Flow-matching iterations per utterance. The SDK defaults to 8; cost is very nearly
# linear in it, so this is the cheapest speed knob in the system and it costs no memory.
# Measured here on a 54-character Indonesian sentence, CPU:
#
#     8 steps  RTF 0.75      6 steps  RTF 0.58      4 steps  RTF 0.41
#     3 steps  RTF 0.32      2 steps  RTF 0.23
#
# Below 3 the artefacts stop being subtle. Render the ladder and judge for yourself:
#     ./scripts/measure/voice_samples.py --steps 8,6,4,3,2
SUPERTONIC_STEPS=4

# Synthesise on the GPU. 13x faster (RTF 0.75 -> 0.06) and it costs ~880 MiB, because
# the CUDA context and cuDNN's workspace come out of the same unified pool as the LLM
# and the ASR decoder. Needs onnxruntime-gpu:
#     .venv/bin/pip install onnxruntime-gpu \
#         --extra-index-url https://pypi.jetson-ai-lab.io/jp6/cu126
#
# NvMap will not reclaim page cache, so what matters is `free`, not `available`. With
# the LLM and a GPU whisper already resident there is not 880 MiB of it: cuDNN then
# fails at the first synthesis and robot-tts rebuilds itself on the CPU, logging why.
# One slow sentence, not a mute robot -- but if you see that line, this is the setting
# to turn off (or free the GPU with WHISPER_USE_GPU=0).
TTS_USE_GPU=1

# ...and refuse to synthesise on the CPU if the GPU cannot be had.
#
# The fallback exists because a slow robot beats a mute one, and it is silent by design:
# robot-tts logs once, rebuilds on the CPU and keeps talking. The failure mode is that
# the log line scrolls away and all you have left is a robot that got slower for no
# visible reason -- measured, Supertonic is ~RTF 1.0 on a loaded CPU against ~0.7 on the
# GPU, so it never stops working, it just stops keeping up.
#
# With this set, a GPU that cannot be had is an ERROR: the sentence is dropped, the
# Services page goes red, and the NEXT utterance retries the GPU -- so freeing memory
# recovers it without a restart. Set it to 0 to get the old quiet fallback back.
TTS_REQUIRE_GPU=1

# How many queued sentences to join into one synthesis call. Fewer, larger calls means
# less per-call overhead and better prosody, because the model sees a whole clause.
#
# Only sentences that have ALREADY arrived are joined -- this never waits for more text
# -- and the first chunk of a reply always goes alone, since that one is what
# time-to-first-audio measures. 1 disables batching.
# 1 = never join queued chunks into one synthesis call.
#
# Batching was a throughput optimisation, and it made the robot sound uneven. Joining
# four sentences into one call keeps the model's own inter-sentence pauses (15.0
# chars/s); rendering them separately does not (18.0 chars/s) -- and which one happens
# depends on whether the LLM produced the text fast enough for the renderer to still
# have it queued. The SAME reply was 19% faster or slower from one turn to the next for
# no reason the listener could see.
#
# Measured 2026-09-17 with this at 1: an identical reply took 9.67 s whether the chunks
# arrived all at once or 1.1 s apart -- 0.1% apart, against 12-19% before. Playback
# stays gapless (0.2-1.3% silence across a 9.7 s reply), so the per-call overhead this
# used to save is no longer worth paying for in consistency.
TTS_BATCH_SENTENCES=1

TTS_SOCKET=/media/jetson/DATA/robot-py/run/tts.sock
TTS_VOICES_DIR=/media/jetson/DATA/robot-py/models/tts/piper

# Audio device. Route through PulseAudio, NOT the raw hw device.
# PulseAudio owns the USB card, so it re-acquires the PCM the moment aplay lets go.
# Opening plughw: directly then works for the first utterance and fails with
# "Device or resource busy" on every reopen after a barge-in (measured, M4).
# Going through `pulse` also makes full-duplex mixing PulseAudio's problem rather
# than ours, and is where module-echo-cancel would sit if barge-in ever needs AEC.
TTS_ALSA_DEVICE=pulse

# WHICH PulseAudio sink -- the exact twin of PULSE_SOURCE in asr.env, and the same bug.
# Without this, `pulse` follows Pulse's default sink, which on this board is the Tegra
# onboard analog output with nothing plugged into it. aplay opens it, accepts every
# sample and reports success, so the turn completes with a real audio_s and the robot
# is simply mute. The speaker is on the same USB device as the microphone.
# List them with: pactl list short sinks
PULSE_SINK=alsa_output.usb-Audio_Tools_USB_Audio_000001-02.mono-fallback

# Voice per language tag (dev-docs/architecture/system-overview.md § Language routing).
TTS_VOICE_EN=en_US-lessac-medium
TTS_VOICE_ID=id_ID-news_tts-medium
TTS_VOICE_AR=ar_JO-kareem-medium

# 1 = load all three voices at startup (~0.39 GB, measured M2) so no utterance pays the
# ~1.5 s load. 0 = load each on first use.
#
# Changed to 0 in M7: with the embedding server added the budget no longer has ~0.26 GB
# spare to hold voices nobody is using. The cost is a one-off ~1.5 s pause the first time
# each language is spoken. Set back to 1 if you drop the embedding server.
# Load the voice at service start instead of on the first sentence of the first turn.
#
# For Supertonic this is not just about the first turn being slow. Winning the GPU needs
# the page cache dropped first (robot/tts/engines.py), and doing that mid-turn spends
# the saving on a cold read of the models it is about to load. At startup nobody is
# waiting, and the cache was just dropped for llama-server anyway.
#
# It costs Supertonic's ~484 MiB (CPU) / ~884 MiB (GPU) from boot rather than from the
# first thing the robot says. On a board this full that is a real choice -- set it to 0
# if you would rather have the memory back until the robot actually speaks.
TTS_PRELOAD=1

LOG_LEVEL=INFO

# Output gain as a percentage, applied to the audio itself rather than a mixer control
# so it behaves the same on any sound card. Tunable live from the dashboard.
TTS_VOLUME=100

# Cut the silence Supertonic pads every synthesis call with.
#
# Measured 2026-09-17 by rendering a phrase one to four times and reading the slope:
# every call carries a FIXED 0.46-0.98 s of padding regardless of how much speech is in
# it. On "Oke." that is 0.35 s of speech inside 1.32 s of audio -- 74% silence. Output
# length is quantised too (1.32, 1.46, 1.88, 2.37 s), so a four-character word still
# costs 1.3 s.
#
# That is what makes a streamed reply sound uneven: the first chunk is short by design
# (CORE_FIRST_MAX_CHARS), so it is mostly padding and drawls, while later, longer chunks
# sound normal -- and whether chunks got batched together varies with how fast the LLM
# produced them, so the same reply is padded differently from one turn to the next.
#
# 0 restores the raw model output. TTS_TRIM_KEEP_MS is the margin left at each end: too
# little clips plosives, too much puts the silence back.
TTS_TRIM_SILENCE=1
TTS_TRIM_KEEP_MS=40        # ...and at the start, where every ms is latency

# The margin left at the END of each chunk, which is NOT the same knob as the start.
#
# Trimming both ends equally fixed each chunk and broke the reply: rendered separately
# the sentences ran into one another at 18.0 chars/s, while the same four sentences
# batched into a single call kept the model's own inter-sentence pauses and came out at
# 15.0 -- the same words, 19% apart, decided by nothing except whether the LLM produced
# them fast enough for TTS_BATCH_SENTENCES to join them. That is the unevenness you hear.
#
# This is what a sentence boundary sounds like, applied identically whichever path
# rendered the chunk. Shorter runs sentences together; longer sounds hesitant.
TTS_TRIM_TAIL_MS=280
