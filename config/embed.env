# robot-embed.service tunables -- the embedding half of M7.
# No secrets (AGENTS.md constraint 8); this file is tracked.

EMBED_MODEL=/media/jetson/DATA/robot-py/models/embed/Qwen3-Embedding-0.6B-Q8_0.gguf

# Qwen3-Embedding uses last-token pooling. Getting this wrong does not error -- it
# silently returns worse vectors, which shows up as retrieval that "sort of works".
EMBED_POOLING=last

# Context per chunk. rag.CHUNK_CHARS is sized to stay under this comfortably.
# 512 rather than 1024 because the compute buffer scales with it -- see EMBED_NGL below.
EMBED_CTX=512

# Batch must be >= context for embeddings, or long chunks are silently truncated.
EMBED_BATCH=512

# CPU only. The GPU belongs to llama-server; embedding is a background job and the
# ingestion path is explicitly off the conversational hot path.
#
# -ngl 0 is NOT enough on its own: llama.cpp still allocates its compute buffer through
# CUDA when the backend is compiled in, and at ctx/batch 1024 that was 761 MiB of the
# same unified pool the LLM needs -- the embedding server simply failed to start with
# `cudaMalloc failed: out of memory`. The service also sets CUDA_VISIBLE_DEVICES= so
# this process never touches the GPU at all.
EMBED_NGL=0

# One slot. llama-server defaults to --parallel -1 (auto) and picked 4 here, giving
# each slot its own KV and compute buffers for no benefit -- ingestion is a background
# job with one request at a time.
EMBED_PARALLEL=1

EMBED_HOST=127.0.0.1
# 8081 is reserved for the NiceGUI dashboard (system-overview.md), so 8082.
EMBED_PORT=8082

# ---- when this server is allowed to be running -----------------------------
#
#   on-demand  robot-core starts it when there is ingestion work queued and stops it
#              again once the queue has drained. 810 MiB back for the ~99.9% of the
#              time nothing is being ingested. This is the default.
#   always     resident, as it was through M7-M9. Choose this if the board has room
#              and you want every question answered against vectors.
EMBED_MODE=on-demand

# How long it stays up after the last piece of work, so a folder of documents does not
# start and stop it per file. If something was evicted to make room (see EMBED_EVICT)
# this is ignored and it goes down almost immediately -- a robot without its LLM is a
# worse state than one more model load.
EMBED_IDLE_S=90

# What may be stopped to make room when the embedding server will not start for lack of
# memory, in the order it is tried. Each one is started again after the embedding work
# is finished AND the embedding server is back down, so the two are never both resident.
# Empty disables eviction: a start that does not fit then simply fails.
#
# Deliberately not `asr`: losing the microphone mid-conversation is silent and confusing,
# where losing the LLM makes the robot say it is not ready.
EMBED_EVICT=llm

# What a QUESTION does when the embedding server is asleep.
#
#   warm   vectors when it happens to be up, keyword search when it is not. Never waits
#          for a model to load, so turn latency does not move. Default.
#   start  wake it and wait. Retrieval is always at full quality; the first turn after
#          an idle period pays the load time on top of the 2393 ms already over target.
#   off    keyword search only; a question never wakes it.
#
# A vector search needs the QUESTION embedded into the same space as the stored chunks,
# and only the model that stored them can do that -- the conversational LLM cannot
# substitute for it, and neither can the database. Under `warm` and `off`, retrieval
# while the server is asleep is keyword matching, which cannot do the cross-lingual
# retrieval M7 was built for: an Indonesian question will not find an English note.
EMBED_RETRIEVAL=warm
