# robot-core.service tunables. No secrets (AGENTS.md constraint 8) -- this file is tracked.

CORE_SOCKET=/media/jetson/DATA/robot-py/run/core.sock
ASR_SOCKET=/media/jetson/DATA/robot-py/run/asr.sock
TTS_SOCKET=/media/jetson/DATA/robot-py/run/tts.sock
LLM_URL=http://127.0.0.1:8080

# How the model is asked to answer.
#
#   json     a JSON object whose shape is enforced by a grammar, not requested in the
#            prompt: {"answer", "language", "foot_direction", "foot_step",
#            "hand_movement", "face", "style"}. ONLY `answer` is spoken; the rest drive
#            the body. `answer` is the first field, and is read out of the token stream
#            as it is written, so speaking still starts before generation finishes.
#   markers  the M6 format -- prose with [lang:xx] and [do:...] in it. Needs nothing of
#            the server beyond streaming, so it still works against a llama.cpp build
#            with no grammar support.
CORE_REPLY_FORMAT=json

# How many tokens the reply may have. `auto` derives it from LLM_CTX, which is the point:
# a fixed number here and a context size over in config/llm.env drift apart the moment
# either changes, and the symptom is answers that stop mid-sentence.
#
# Under `json` a reply that hits the cap is not merely short. The grammar is still inside
# the `answer` string, so the object never closes and `language`, `foot_direction`,
# `foot_step`, `hand_movement`, `face` and `style` are never generated -- the robot speaks
# half a sentence and does not move. It now says so: one WARNING per truncated reply, and
# a `truncated` event on the dashboard.
#
#   auto   LLM_CTX minus the prompt budget (66% of the window) minus a 128-token margin,
#          capped at 1024 so an answer stays an answer. At LLM_CTX=4096 that is 1024.
#   <n>    an explicit cap, taken at face value. Use it to make replies deliberately
#          SHORTER; to make them longer, raise LLM_CTX and leave this alone.
#
# Note the Memory page can also pin this, and a pinned value wins over both. `./run.sh
# <mode> --check` lists what the dashboard has pinned.
CORE_MAX_TOKENS=auto
CORE_TEMPERATURE=0.7

# ---- what the microphone may do while the robot is talking ------------------
#
# The speaker and the microphone are one USB device, so anything the robot says can
# arrive back a few milliseconds later looking exactly like someone talking. Under
# `interrupt` that makes the robot cancel itself mid-sentence and then transcribe its
# own voice as your next question.
#
#   interrupt      barge-in. Speaking over the robot cuts it off. Most responsive, and
#                  the only mode that is unsafe when the speaker couples into the mic.
#   no_interrupt   the microphone is ignored from the moment audio starts until
#                  CORE_LISTEN_TAIL_MS after it stops. The robot finishes its sentence.
#   wake_word      as no_interrupt, and nothing starts a turn unless the transcript
#                  names the robot (CORE_WAKE_WORD).
#
# Tunable live from the dashboard's Config -> Listening page.
# Default is `no_interrupt`, not `interrupt`. M4 measured the acoustic coupling on this
# hardware as negligible and barge-in was the default on that basis; a real conversation
# then showed the robot cancelling its own sentences and transcribing its own voice.
# Failing safe means shipping the mode that cannot do that, and letting barge-in be the
# thing you turn on once you know your speaker does not feed back.
CORE_LISTEN_MODE=no_interrupt

# How long after the last sample the microphone stays ignored, in the two non-interrupt
# modes. Room echo and the speaker's own decay arrive after playback ends, and an
# utterance that began during playback is still being decoded when it stops -- so this,
# not the grace window below, is what actually stops the robot answering itself.
CORE_LISTEN_TAIL_MS=700

# The name the robot answers to under wake_word. Matched loosely: an ASR hears
# "hey uni", "unit", "you knit". Empty means everything wakes it.
CORE_WAKE_WORD=robot

# Ignore VAD speech for this many ms after audio STARTS. Only used by `interrupt`, as
# a guard against the leading edge of the robot's own voice. 0 = off, which was correct
# on the hardware measured in M3/M4. The other two modes gate on the whole utterance
# instead, which is strictly more reliable.
CORE_BARGE_IN_GRACE_MS=0

LOG_LEVEL=INFO

# STM32 serial device (dev-docs/architecture/serial-protocol.md). Leave empty to run
# without a body -- the orchestrator then sends no heartbeat and issues no motion.
# Pin the real device with a udev rule so it survives a replug; note that a USB
# soundcard can also claim /dev/ttyACM0, so match on the STM vendor id (0483).
# Set to /dev/robot-stm32 once the board is attached (scripts/bringup/setup_udev.sh).
# MUST be a stable path, not /dev/ttyACM*: a replug or a service restart changes the
# number, and the orchestrator would then retry a device that no longer exists.
# Empty means no body -- health shows the serial row as absent rather than failed.
STM32_PORT=

# Knowledge store (M7). Leave EMBED_URL empty to run without retrieval or save_memory --
# the robot still converses, it just does not remember anything.
EMBED_URL=http://127.0.0.1:8082
KNOWLEDGE_DB=/media/jetson/DATA/robot-py/run/knowledge.db
RAG_K=4

# Dashboard link (M8). robot-ui connects here over a WebSocket -- it never imports
# orchestrator code, so a UI crash cannot take the robot down.
# Loopback only: the dashboard is the only thing that should reach it, and the
# dashboard itself is what carries session auth for the LAN.
CORE_WS_HOST=127.0.0.1
CORE_WS_PORT=8090
# Shared secret for the websocket upgrade. Set it in .env (gitignored), not here.
CORE_WS_TOKEN=

# How soon the robot starts talking. The first chunk breaks at a clause once it passes
# CORE_FIRST_MAX_CHARS instead of waiting for the sentence to end, and never breaks
# shorter than CORE_FIRST_MIN_CHARS.
#
# Time to the first spoken word is roughly proportional to the length of that chunk:
# measured on this board, 5 chars -> 235 ms, 44 chars -> 2258 ms, 130 chars -> 7551 ms.
# The old default of 90 was chosen when Supertonic had the GPU to itself at RTF 0.06; on
# a loaded board it is RTF ~0.7 and those 90 characters cost over five seconds.
#
# Lower is snappier and breaks mid-sentence more often. The remainder renders while the
# first chunk plays and the player is gapless, so the cost is where the breath falls,
# not a pause. Listen before going below ~30.
CORE_FIRST_MAX_CHARS=40
CORE_FIRST_MIN_CHARS=4

# Say something human while the LLM is still writing.
#
# Measured on this board: ~2.9 s separates the end of a question from the first word of
# an answer -- ASR decode, the model reaching a speakable clause, synthesising it. None
# of that is removable. The SILENCE is. Twenty phrases per language (see FILLERS in
# src/robot/core/language.py), drawn at random, each about a second long, and
# pre-rendered to PCM when robot-core connects to robot-tts -- so the acknowledgement
# itself costs no synthesis at the moment it is needed.
#
# Voice turns only: /chat is read, not heard, and has no gap to cover.
# 0 for a robot that waits quietly instead.
CORE_FILLER=1
