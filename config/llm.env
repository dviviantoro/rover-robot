# robot-llm.service tunables. No secrets here (AGENTS.md constraint 8) -- this file is tracked.
# Restart the service after editing:  sudo systemctl restart robot-llm

# Qwen2.5-3B rather than Qwen3-4B since 2026-09-14, so that the LLM, whisper `small`
# and Supertonic can all hold the GPU at once -- with the 4B they fit at boot and
# Supertonic loses its CUDA allocation under load, rebuilding on the CPU mid-conversation
# (first audio 2.1 s -> 8.2 s). This gives back 841 MiB and holds.
#
# It is the bake-off's own recommendation and the cost is measured, not free: 17/19
# answers against Qwen3-4B's 19/19, 38/39 facts against 39/39 -- and, the column that
# decided it, it still REFUSES to invent a school fee the document does not contain,
# which Llama-3.2-3B, gemma-3-1b and Sailor2-1B all did.
# See dev-docs/architecture/memory-budget.md, "LLM bake-off".
#
# To go back: set this to Qwen3-4B-Instruct-2507-Q4_K_M.gguf and expect Supertonic on
# the CPU, or free the room somewhere else (whisper `base` buys about the same).
LLM_MODEL=models/llm/Llama-3.2-3B-Instruct-Q4_K_M.gguf

# planning/TECH_STACK.md ## Think: 2048-4096 tokens. KV cache scales with this --
# memory-budget.md lists 4k -> 2k as the first trim if the budget gets tight.
#
# Set to 2048 in M9. At 4096 the LLM is 3679 MiB and, with the rest of the stack up,
# there is not enough contiguous memory left for it to RESTART after a crash -- which
# makes Restart=on-failure useless exactly when it is needed. 2048 costs 288 MiB of KV
# cache and buys a stack that can actually recover. Raise it back on a board with
# nothing else attached, and re-run scripts/hardening/failure_drills.py to confirm.
LLM_CTX=2048

# Offload every layer. Memory is unified, so this costs no extra RAM over CPU-only.
LLM_NGL=99

# Flash attention shrinks the KV cache -- directly relevant to the 8 GB ceiling.
LLM_FLASH_ATTN=auto

# Single conversation at a time; more slots would divide the context.
LLM_PARALLEL=1

LLM_HOST=127.0.0.1
LLM_PORT=8080
