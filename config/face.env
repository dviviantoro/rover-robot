# robot-face.service tunables. NO SECRETS (AGENTS.md constraint 8) -- CORE_WS_TOKEN lives
# in .env, which is gitignored.

# robot-core's dashboard websocket. Loopback on purpose: the panel runs on the robot, and
# in development it is reached with `ssh -L 8090:127.0.0.1:8090` rather than by opening
# CORE_WS_HOST to the LAN.
FACE_WS_URL=ws://127.0.0.1:8090/

# How many conversation lines the panel draws. The rest stay in scrollback so the last
# exchange survives a robot-core restart. 7 fits 1366x768 at the current type size.
FACE_CHAT_LINES=7

# robot-core never sends a WebSocket Ping, though it answers ours, so keepalive is
# entirely the client's job. 20 s matches what the browser dashboard uses.
FACE_PING_S=20
# Silence this long means the link is dead whatever TCP still believes.
FACE_DEAD_LINK_S=45

# Renders straight to DRM/KMS -- no compositor, no X11, no Wayland, no seat.
# Measured on this board: card1-DP-1 connected at 1366x768, and `jetson` (group video)
# can take and drop DRM master on /dev/dri/card1 without root.
SLINT_BACKEND=linuxkms-software

# Pin the connector and orientation once the real panel is fitted. `list` makes Slint
# print what it found and exit, which is how to discover the names.
#   SLINT_DRM_OUTPUT=list
# SLINT_DRM_OUTPUT=DP-1
SLINT_KMS_ROTATION=0

LOG_LEVEL=info
