# robot-whisper.service tunables -- the speech decoder.
# No secrets (AGENTS.md constraint 8) -- this file is tracked.
#
# The ONLY decoder since Qwen3-ASR was removed on 2026-09-14, so this service is not
# optional: without it robot-asr keeps the microphone and the barge-in signal and loses
# every utterance. WHISPER_MODEL below IS the ASR choice, and it is a choice of size --
# the Memory page lists what is installed, smallest first, with what each costs.
#
# It is also a choice of PRECISION, and that one is nearly free. These files are the
# GGML conversions of OpenAI's own checkpoints from `ggerganov/whisper.cpp`, and the
# large-v3-turbo weights ship quantised as well as fp16. Measured on this board,
# 2026-09-15, nine samples across id/en/ar:
#
#                        resident   mean decode   transcripts
#   turbo fp16            1846 MiB      1.68 s    9/9 language tags, reference text
#   turbo q5_0            1190 MiB      1.46 s    identical, character for character
#
# 656 MiB and 223 ms for no measurable loss -- and on one Arabic sample q5_0 restored
# sentence punctuation that fp16 dropped. Going from fp16 to q5_0 is the cheapest
# memory on the board; dropping to `small` is what costs accuracy. Fetch others with
# `./scripts/models/fetch_whisper.sh large-v3-turbo-q8_0`.
#
# Why a server rather than an in-process model: whisper.cpp's C API takes a ~40-field
# params struct by value, and binding that from Python means tracking its layout across
# whisper.cpp versions with a silent-corruption failure mode. The HTTP contract does not
# move. It also means the ASR model can be stopped on its own when the board runs out of
# room, which on 8 GB is a real operation and not a hypothetical.

WHISPER_MODEL=models/asr/whisper/ggml-large-v3-turbo-q8_0.bin

WHISPER_HOST=127.0.0.1
# 8080 is the LLM, 8081 the dashboard, 8082 embeddings.
WHISPER_PORT=8083

# ---- GPU ------------------------------------------------------------------
#
# 1 = run the encoder on the GPU (the default; needs a CUDA build --
# scripts/models/build_whisper.sh). The encoder is the expensive half of a decode and
# exactly the shape a GPU is good at, and ASR decode sits on the critical path of every
# spoken turn -- it cannot be overlapped, and ROADMAP M4 has latency at 2393 ms against
# a 1500 ms target.
#
# 0 = CPU, no rebuild needed. Set this if the LLM starts failing to allocate its KV
# cache: on Tegra the GPU draws from the same unified pool as the CPU, NvMap will not
# force the kernel to reclaim page cache for either of them, and two CUDA processes
# competing for the last few hundred megabytes lose the race non-deterministically.
# That is the same failure mode documented in TROUBLESHOOTING.md for llama-server, and
# putting a second CUDA allocator on the board makes it more likely, not less.
#
# Check which one is actually in use: the startup line in .cache/tmp/whisper.log says
# so, and `python scripts/measure/whats_running.py` reports the running process.
WHISPER_USE_GPU=1

# Flash attention shrinks the attention buffers -- the same reason LLM_FLASH_ATTN is on.
WHISPER_FLASH_ATTN=1

# CPU threads. Still used for the parts that do not run on the GPU, and for everything
# when WHISPER_USE_GPU=0.
WHISPER_THREADS=4

# 'auto' detects per utterance, which is the entire reason this engine exists:
# Qwen3-ASR reports no language at all (TECH_STACK.md § Listen), so English and Bahasa
# Indonesia were indistinguishable before the LLM saw the turn. Pin to en/id/ar only if
# you are certain the robot will hear exactly one language -- it makes short utterances
# more accurate and removes the detection pass.
WHISPER_LANGUAGE=auto

# NOTE: whisper takes ONE language or 'auto' -- it has no "these three" setting. Which
# languages the robot will actually act on is enforced downstream by ASR_LANGUAGES in
# config/asr.env, because a filter that runs after detection can express a set and a
# decoder flag cannot.

LOG_LEVEL=INFO

# GPU is not optional, it is a requirement.
#
# `--no-gpu` is the only thing that stops whisper.cpp TRYING, and trying is not
# succeeding: on a full board it initialises the CUDA backend, fails to allocate, and
# carries on at RTF ~8 instead of 0.17 -- the robot then appears to hang on every
# utterance with nothing in the log at the moment it happens. `use gpu = 1` is the
# request; `CUDA0 total size` is the outcome, and run_stack.sh checks for the outcome.
#
# With this set, a whisper-server that came up on the CPU is stopped and reported rather
# than left running slowly. Set it to 0 only if the CPU is genuinely the plan (which
# means tiny or base -- small and above are unusable there).
WHISPER_REQUIRE_GPU=1
