# robot-asr.service tunables. No secrets (AGENTS.md constraint 8) -- this file is tracked.

ASR_SOCKET=/media/jetson/DATA/robot-py/run/asr.sock
VAD_MODEL=/media/jetson/DATA/robot-py/models/vad/silero_vad.onnx

# What the robot is allowed to hear, most-preferred first. The first entry is also the
# language it falls back to when nothing else decides a reply's language.
#
# This is a FILTER, and it needs to be. whisper reports a language for everything it
# decodes -- a cough, the fan, a burst of the robot's own voice coming back off the
# speaker -- and it usually calls those Chinese. Without this they reach the LLM as if
# somebody had said them, which is exactly what a robot answering nonsense looks like.
#
ASR_LANGUAGES=id,en,ar

# Capture device. Route through PulseAudio for the same reason as playback --
# see config/tts.env. `arecord -L` lists the raw alternatives.
ASR_ALSA_DEVICE=pulse

# WHICH PulseAudio source. Without this the ALSA `pulse` device follows Pulse's default
# source, which on this board is the Tegra onboard analog input with nothing plugged
# into it -- capture then returns perfect digital silence and the robot is deaf with no
# error anywhere. Found only when the dashboard's level meter read -90 dB.
# List them with: pactl list short sources
PULSE_SOURCE=alsa_input.usb-Audio_Tools_USB_Audio_000001-02.mono-fallback


# Endpointing: how much silence closes an utterance. ROADMAP M3 asks for 600-700 ms.
# Lower feels snappier but clips people who pause mid-thought.
VAD_MIN_SILENCE=0.65

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# What the robot does about a noisy room. Three defences; src/robot/asr/noise.py
# has the measurements behind every number here.
# ---------------------------------------------------------------------------

# 1. The level gate. An utterance whose speech level is not this many dB above the
# room's own noise floor is dropped BEFORE it is decoded -- nothing within a few dB of
# the floor is intelligible, and this saves a GPU decode rather than filtering the
# result afterwards. Every drop is logged with the numbers it dropped on:
#   grep 'robot-asr: dropped' .cache/tmp/asr.log
# 0 disables it.
ASR_NOISE_GATE_DB=6.0

# 2. The confidence gate. whisper reports, per segment, how sure it is that there was no
# speech in the audio -- and then transcribes it anyway. Measured on this board:
#   real speech, clean down to 0 dB SNR   no_speech 0.006-0.087
#   room noise with no speech in it       no_speech 0.820-0.911
# so 0.6 sits in a gap with nothing in it. 1.0 accepts everything. Qwen3-ASR reports no
# such number and is unaffected.
ASR_MAX_NO_SPEECH=0.6

# ...and how incoherent a transcript may be before it is dropped (mean token
# log-probability; 0 is certain). Far less separated than no_speech -- whisper scores a
# repeated token *well* -- so this only catches the genuinely garbled. Worst real speech
# measured was -0.63. -90 disables.
ASR_MIN_LOGPROB=-1.0

# 3. Noise suppression (GTCRN, inside sherpa-onnx -- no new dependency). off | stream |
# utterance.
#
# OFF BY DEFAULT, AND THE DEFAULT IS MEASURED, NOT ASSUMED. On synthetic mixtures of
# Piper speech with stationary noise and with babble, suppression made whisper's word
# error rate WORSE at every SNR tried (+27% to +314%) and left Qwen3-ASR about where it
# started. That is the known artefact problem: whisper was trained on noisy audio, and
# a denoiser's output is not the kind of noisy it expects.
#
# It is still here, one word away, because none of that was measured in YOUR room --
# far-field speech and real reverberation are not what the synthetic test contains.
# Record 30 seconds of the room that is giving trouble and settle it:
#   arecord -f S16_LE -c1 -r16000 -d 30 -D pulse /tmp/busy.wav
#   ./scripts/measure/denoise_ab.py --noise /tmp/busy.wav
#
#   stream     clean every frame, before the VAD -- so the room cannot open an
#              utterance at all. RTF 0.12 of one core, continuously, +4 MiB.
#   utterance  clean only what the VAD already kept. No idle cost; adds ~0.1x the
#              utterance length to every decode. +19 MiB.
ASR_DENOISE=off
DENOISE_MODEL=/media/jetson/DATA/robot-py/models/denoise/gtcrn_simple.onnx
DENOISE_THREADS=1
