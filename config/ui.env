# robot-ui.service tunables. NO SECRETS HERE (AGENTS.md constraint 8) --
# ROBOT_UI_PASSWORD and ROBOT_UI_STORAGE_SECRET live in .env, which is gitignored.

UI_HOST=0.0.0.0
UI_PORT=8081

# The orchestrator's dashboard websocket. Loopback: robot-core binds 127.0.0.1, and
# this dashboard is the only thing that should reach it.
CORE_WS_URL=http://127.0.0.1:8090

LOG_LEVEL=INFO
